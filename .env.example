NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MONGODB_URI=
MONGODB_DB=peopleos
# Bootstrap applies only to this workspace. Use a different stable ID for each tenant.
WORKSPACE_ID=your-company
WORKSPACE_NAME=Your company
# These verified Google accounts can bootstrap admin membership in WORKSPACE_ID only.
# Team members can be provisioned by an administrator before Google sign-in.
# Verified Google users without memberships can create their first workspace.
ADMIN_EMAILS=admin@yourcompany.com

# Demo routes use sample browser records only; disabled in production by default.
# ALLOW_DEMO_ACCESS=true
